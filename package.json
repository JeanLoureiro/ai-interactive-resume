{
  "name": "ai-interactive-resume",
  "version": "1.0.0",
  "private": true,
  "description": "A source-grounded assistant that answers interview questions about Jean Loureiro's professional background, and refuses when it cannot cite.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "ingest": "tsx scripts/ingest.ts",
    "eval": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/eval.ts",
    "ask": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/ask.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "packageManager": "pnpm@10.24.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.127.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
