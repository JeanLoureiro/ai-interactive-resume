{
  "name": "ai-interactive-resume",
  "version": "1.0.0",
  "private": true,
  "description": "A source-grounded assistant that answers interview questions about Jean Loureiro's professional background, and refuses when it cannot cite.",
  "scripts": {
    "dev": "next dev",
    "build": "pnpm models:fetch && next build",
    "models:fetch": "tsx scripts/fetch-models.ts",
    "start": "next start",
    "ingest": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/ingest.ts",
    "resume:preview": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/resume-preview.ts",
    "db:migrate": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "db:setup": "pnpm db:migrate && pnpm ingest",
    "eval": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/eval.ts",
    "eval:retrieval": "tsx scripts/eval-retrieval.ts",
    "ask": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/ask.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "packageManager": "pnpm@10.24.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.127.0",
    "@huggingface/transformers": "4.3.0",
    "drizzle-orm": "0.45.3",
    "mammoth": "1.13.0",
    "next": "16.3.5",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "unpdf": "1.8.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
