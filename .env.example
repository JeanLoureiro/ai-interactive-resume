# Copy to .env.local and fill in. Never commit the filled-in file.

# ── Required ────────────────────────────────────────────────────────────────
# Anthropic API key. Get one at https://console.anthropic.com/settings/keys
# Used server-side only — never exposed to the browser, never NEXT_PUBLIC_*.
ANTHROPIC_API_KEY=sk-ant-...

# Who the assistant answers about. The full name opens the system prompt.
SUBJECT_NAME="Jean Loureiro"

# ── Optional ────────────────────────────────────────────────────────────────
# How the page and answers refer to them, e.g. a first name. Defaults to SUBJECT_NAME.
SUBJECT_SHORT_NAME=Jean

# The resume to ingest: .pdf, .docx or .md. Defaults to knowledge/sources/cv.md (the worked example).
# A PDF or DOCX is split into entries by the model and every line is checked against the file's own
# text; preview what would be stored with `pnpm resume:preview <file>` before running `pnpm ingest`.
RESUME_PATH=

# Model that splits a PDF or DOCX resume into entries. Defaults to claude-haiku-4-5: on a real
# resume it matched Sonnet's result in a quarter of the time at a sixth of the cost.
RESUME_MODEL=

# Extra sources. Leave blank to skip that source entirely; the CV is always used.
LINKEDIN_PROFILE=https://au.linkedin.com/in/jeanloureiro
GITHUB_USERNAME=JeanLoureiro

# Model used for answering. Defaults to claude-sonnet-5.
# The eval runs against claude-sonnet-5 and claude-haiku-4-5 for comparison.
ANTHROPIC_MODEL=claude-sonnet-5

# Number of knowledge units retrieved per question. Defaults to 5.
RETRIEVAL_TOP_K=5

# hybrid (default) fuses BM25 with a local embedding model; bm25 turns the model off.
RETRIEVAL_MODE=hybrid

# Postgres. Blank = the app serves the committed JSON snapshot as a read-only demo.
# Local: `docker compose up -d`, set postgres://resume:resume@localhost:54329/resume, then `pnpm db:setup`.
# Supabase: use the transaction pooler URL (port 6543) from Project Settings > Database.
DATABASE_URL=

# Protects /api/cron/keepalive, the daily query that stops a free Supabase project pausing.
# Any long random string, e.g. `openssl rand -hex 32`. Vercel Cron sends it automatically.
CRON_SECRET=

# Enables /admin, where you upload a new resume, review every unit and publish it. Needs a database.
# Blank = /admin is a 404. Use a long random password, e.g. `openssl rand -base64 24`.
ADMIN_PASSWORD=
