# Copy to .env.local and fill in. Never commit the filled-in file.

# ── Required ────────────────────────────────────────────────────────────────
# Anthropic API key. Get one at https://console.anthropic.com/settings/keys
# Used server-side only — never exposed to the browser, never NEXT_PUBLIC_*.
ANTHROPIC_API_KEY=sk-ant-...

# Who the assistant answers about. The full name opens the system prompt.
SUBJECT_NAME="Jean Loureiro"

# ── Optional ────────────────────────────────────────────────────────────────
# How the page and answers refer to them, e.g. a first name. Defaults to SUBJECT_NAME.
SUBJECT_SHORT_NAME=Jean

# Extra sources. Leave blank to skip that source entirely; the CV is always used.
LINKEDIN_PROFILE=https://au.linkedin.com/in/jeanloureiro
GITHUB_USERNAME=JeanLoureiro

# Model used for answering. Defaults to claude-sonnet-5.
# The eval runs against claude-sonnet-5 and claude-haiku-4-5 for comparison.
ANTHROPIC_MODEL=claude-sonnet-5

# Number of knowledge units retrieved per question. Defaults to 5.
RETRIEVAL_TOP_K=5
